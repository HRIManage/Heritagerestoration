# ── Client analytics & Search Console (VITE_ = exposed to the browser) ──────
# Set these in Vercel → Settings → Environment Variables, then redeploy.
# Each vendor stays completely inert until its ID is provided.

# GA4 Measurement ID — analytics.google.com → Admin → Data streams
VITE_GA4_ID=
# Google Search Console: the content="..." token from the "HTML tag"
# verification method. (Or verify via DNS / the GA4 tag instead.)
VITE_GSC_VERIFICATION=
# Google Ads conversion tracking (optional — only if running Google Ads)
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LEAD_LABEL=
# Meta (Facebook) Pixel (optional)
VITE_META_PIXEL_ID=


# Google reviews integration
# Preferred: Google Business Profile API. Requires OAuth access to the verified business profile.
GOOGLE_BUSINESS_PROFILE_ACCOUNT_ID=
GOOGLE_BUSINESS_PROFILE_LOCATION_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=
GOOGLE_BUSINESS_PROFILE_REFRESH_TOKEN=


# Optional temporary/testing token. Prefer refresh-token OAuth above for production.
GOOGLE_BUSINESS_PROFILE_ACCESS_TOKEN=

# Fallback option: Places Details API. This only returns a small review sample.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Default: 6 hours
GOOGLE_REVIEWS_CACHE_MS=21600000
GOOGLE_REVIEWS_LIMIT=6
